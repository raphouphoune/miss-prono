NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local: http://localhost:3000. Vercel can supply the production URL automatically;
# set this explicitly in Vercel after the first deployment for a stable canonical URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Compatibilité avec les anciens projets : NEXT_PUBLIC_SUPABASE_ANON_KEY

# À configurer avant ouverture publique (les pages légales affichent les champs manquants)
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_PUBLISHER_PHONE=
LEGAL_CONTACT_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_PRIVACY_LEGAL_BASES=
LEGAL_RETENTION_POLICY=
LEGAL_DATA_LOCATION=
